{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"rootDir": "src",
		"outDir": "out",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	}
}
